# Copy this to ".env" in the repo ROOT (same folder as docker-compose.yml).
# docker-compose reads THIS file automatically to fill in ${...} values
# inside docker-compose.yml. It is separate from backend/.env, which Django
# itself reads.

DB_NAME=MedaPlus
DB_USER=postgres
DB_PASSWORD=change-me

# Point this at wherever Caddy will be reachable — for now that's the
# server's IP address, later it'll be your domain.
VITE_API_URL=http://187.7.16.5/api
