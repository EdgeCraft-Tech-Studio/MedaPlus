# Caddyfile
# This is the "no domain yet, just an IP" version — plain HTTP on port 80.
# Once your boss gives you a domain name pointed at the server, replace
# the ":80" block below with your domain (see the commented example at
# the bottom) and Caddy will get you free automatic HTTPS for it.

:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin* {
        reverse_proxy backend:8000
    }

    handle /static/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}

# --- Once you have a domain, delete the block above and use this instead ---
# yourdomain.com {
#     handle /api/* {
#         reverse_proxy backend:8000
#     }
