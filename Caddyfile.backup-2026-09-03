
api.ethiomeda.com {
    encode zstd gzip

    reverse_proxy {
        dynamic a storeledger-api 8000 {
            refresh 10s
            resolvers 127.0.0.11
            versions ipv4
        }
    }
}

:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /admin* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        root * /app
        file_server
    }

    handle /static/* {
        root * /app
        file_server
    }

    handle {
        reverse_proxy frontend:80
    }
}
